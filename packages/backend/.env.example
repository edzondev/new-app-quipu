# Variables of the Convex deployment (not read from this file). Set them per deployment,
# dev and prod separately: `pnpm exec convex env set NAME value` or the dashboard.
# Names only: never commit real values.

# Public URL of the web app. Polar sends people back here after checkout and the portal.
SITE_URL=
# Better Auth
BETTER_AUTH_SECRET=
PASSKEY_RP_ID=
PASSKEY_RP_NAME=
# Email (Resend). OTP_DELIVERY=log prints the code to the Convex logs instead of sending it.
RESEND_API_KEY=
RESEND_FROM=
OTP_DELIVERY=

# Polar. All three are required: the deploy fails without them.
# Organization access token. Needs read products, create checkouts, create customer sessions and webhooks.
POLAR_ORGANIZATION_TOKEN=
# Secret of the webhook that points to https://<deployment>.convex.site/polar/events
POLAR_WEBHOOK_SECRET=
# "sandbox" or "production". Never left to a default.
POLAR_SERVER=
