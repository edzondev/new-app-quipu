{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react"],
	"jsPlugins": ["@convex-dev/eslint-plugin"],
	"categories": {
		"correctness": "error"
	},
	"ignorePatterns": ["**/routeTree.gen.ts", "**/convex/_generated/**"],
	"rules": {
		"@convex-dev/no-old-registered-function-syntax": "error",
		"@convex-dev/require-args-validator": "error",
		"@convex-dev/require-access-control": "error",
		"@convex-dev/import-wrong-runtime": "error",
		"@convex-dev/explicit-table-ids": "error",
		"@convex-dev/no-filter-in-query": "error",
		"@convex-dev/no-collect-in-query": "warn",
		"@convex-dev/no-top-of-hour-crons": "warn",
		"@convex-dev/no-schema-import-cycle": "error",
		"@convex-dev/no-duplicate-indexes": "error",
		"@convex-dev/no-process-env": "warn"
	},
	"env": {
		"builtin": true
	}
}
